# Copy to .env (git-ignored). All values below are fake.
# Both DB URLs must be Supabase SESSION POOLER URIs (port 5432), using the asyncpg driver.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres.fakeref:fake-password@aws-0-region.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql+asyncpg://postgres.faketestref:fake-password@aws-0-region.pooler.supabase.com:5432/postgres

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=fake-fernet-key-replace-me
# argon2 hash of the owner password (generated by a later task's helper)
OWNER_PASSWORD_HASH=fake-argon2-hash-replace-me

# Fine-grained, read-only GitHub token (optional)
GITHUB_TOKEN=github_pat_fake
# Gemini free-tier API key (optional)
GEMINI_API_KEY=fake-gemini-key
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_QUALITY=gemini-flash-latest
GEMINI_RPM_FAST=10
GEMINI_RPM_QUALITY=5

FRONTEND_ORIGINS=["http://localhost:5173"]
MEDIA_ROOT=var/media
# Mermaid renderer (defaults: tools/node_modules/.bin/mmdc, tools/puppeteer-config.json)
# MMDC_PATH=tools/node_modules/.bin/mmdc
# MMDC_PUPPETEER_CONFIG=tools/puppeteer-config.json
POLL_INTERVAL_MINUTES=180
# JSON list, e.g. ["brag","--flag"]; leave unset to disable video
# BRAG_COMMAND=["brag"]
VIDEO_TIMEOUT_S=600
ALLOW_PUBLIC_BIND=false
